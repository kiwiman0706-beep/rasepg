# このファイルは RASEPG Admin が自動生成/更新します(手動編集も可)。
# コピーして .env として使用: cp .env.example .env

TZ=Asia/Tokyo

# ---- 保存先(ホスト側パス) ----
# 録画一時 + エンコード作業(外付けSSD推奨)
RECORDED_TMP=/mnt/ssd/recorded
# 最終保存(NAS/SMB マウント先)
RECORDED_NAS=/mnt/nas

# ---- DB ----
DB_NAME=epgstation
DB_USER=epgstation
DB_PASSWORD=epgstation
DB_ROOT_PASSWORD=change-me-root
